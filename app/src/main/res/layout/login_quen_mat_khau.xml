<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp">
    <TextView
        android:id="@+id/tvTieuDe"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#81B4AA"
        android:gravity="center"
        android:fontFamily="serif"
        android:text="@string/txt_forgot_pass"
        android:textSize="28sp"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/edt_forgot_email"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="email"
        android:layout_margin="10dp"
        android:fontFamily="serif"
        android:background="@drawable/edt_hcn_bo_tron"
        android:inputType="textEmailAddress"
        android:drawableStart="@drawable/icon_lock"
        android:drawableEnd="@drawable/icon_eye_visibility"
        android:drawablePadding="8dp"
        android:padding="12dp" />
    <EditText
        android:id="@+id/edt_forgot_sdt"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Số điện thoại"
        android:layout_margin="10dp"
        android:fontFamily="serif"
        android:background="@drawable/edt_hcn_bo_tron"
        android:inputType="phone"
        android:drawableStart="@drawable/icon_lock"
        android:drawableEnd="@drawable/icon_eye_visibility"
        android:drawablePadding="8dp"
        android:padding="12dp" />
    <EditText
        android:id="@+id/edt_pass_new_enter"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Nhập mật khẩu mới"
        android:layout_margin="10dp"
        android:fontFamily="serif"
        android:background="@drawable/edt_hcn_bo_tron"
        android:inputType="textPassword"
        android:drawableStart="@drawable/icon_lock"
        android:drawableEnd="@drawable/icon_eye_visibility"
        android:drawablePadding="8dp"
        android:padding="12dp" />
    <EditText
        android:id="@+id/edt_pass_new_re_enter"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Nhập mật khẩu mới"
        android:layout_margin="10dp"
        android:fontFamily="serif"
        android:background="@drawable/edt_hcn_bo_tron"
        android:inputType="textPassword"
        android:drawableStart="@drawable/icon_lock"
        android:drawableEnd="@drawable/icon_eye_visibility"
        android:drawablePadding="8dp"
        android:padding="12dp" />
    <Button
        android:id="@+id/btn_thay_mat_khau"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/txt_doi_mat_khau"
        android:backgroundTint="#81B4AA"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-condensed"/>

</LinearLayout>