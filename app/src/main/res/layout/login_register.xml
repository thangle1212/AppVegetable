<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#90CCC3"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/draw_bo_tron_login"
        android:orientation="vertical"
        android:layout_marginTop="-30dp"
        android:padding="24dp"
        tools:ignore="ExtraText">

<!-- Thanh chọn đăng nhập , đăng ký -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_login"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/txt_login"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/txt_dang_ki"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/txt_dang_ki"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

 <!-- Form đăng nhập -->
        <LinearLayout
            android:id="@+id/form_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp">

  <!--  nhập tài khoản -->
            <EditText
                android:id="@+id/edt_user_login"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Tên đăng nhập"
                android:background="@drawable/edt_hcn_bo_tron"
                android:inputType="text"
                android:drawableStart="@drawable/icon_user"
                android:drawablePadding="8dp"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                tools:ignore="Autofill,HardcodedText" />

 <!-- nhập mật khẩu -->
            <EditText
                android:id="@+id/edt_pass_login"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Mật khẩu"
                android:background="@drawable/edt_hcn_bo_tron"
                android:inputType="textPassword"
                android:drawableStart="@drawable/icon_lock"
                android:drawableEnd="@drawable/icon_eye_visibility"
                android:drawablePadding="8dp"
                android:padding="12dp"
                tools:ignore="Autofill,HardcodedText" />
   <!-- quên mật khẩu -->
            <TextView
                android:id="@+id/txt_forgot_pass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp"
                android:paddingTop="8dp"
                android:text="@string/txt_forgot_pass"
                android:textColor="@android:color/holo_blue_dark"
                android:textStyle="bold" />
  <!-- button đăng nhập -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/txt_login"
                android:backgroundTint="#81B4AA"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-condensed"/>
        </LinearLayout>


<!--form đăng kí-->
  <!-- cái này : android:visibility="gone"  là để ẩn form đăng kí-->
            <LinearLayout
                android:id="@+id/form_dang_ki"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="24dp">

    <!-- nhập tài khoản -->
                <EditText
                    android:id="@+id/edt_user_dang_ki"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Tên đăng nhập"
                    android:background="@drawable/edt_hcn_bo_tron"
                    android:inputType="text"
                    android:drawableStart="@drawable/icon_user"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    tools:ignore="Autofill,HardcodedText" />

  <!-- nhập mật khẩu -->
                <EditText
                    android:id="@+id/edt_pass_dang_ki"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="Mật khẩu"
                    android:background="@drawable/edt_hcn_bo_tron"
                    android:inputType="textPassword"
                    android:drawableStart="@drawable/icon_lock"
                    android:drawableEnd="@drawable/icon_eye_visibility"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    tools:ignore="Autofill,HardcodedText" />
 <!-- nhập lại mật khẩu -->

                <EditText
                    android:id="@+id/edt_pass_re_enter"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/edt_hcn_bo_tron"
                    android:drawableStart="@drawable/icon_lock"
                    android:drawableEnd="@drawable/icon_eye_visibility"
                    android:drawablePadding="8dp"
                    android:hint="Nhập lại mật khẩu"
                    android:inputType="text"
                    android:padding="12dp"
                    tools:ignore="Autofill,HardcodedText" />
 <!-- button đăng nhập -->
                <Button
                    android:id="@+id/btn_dang_ki"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="@string/txt_dang_ki"
                    android:backgroundTint="#81B4AA"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-condensed"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


