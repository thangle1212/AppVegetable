<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp">

    <!-- CardView cho mỗi sản phẩm -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/img_rau_muong"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="TODO"
                android:scaleType="centerCrop"
                android:src="@drawable/rau_muong"
                tools:ignore="ContentDescription,HardcodedText" />

            <!-- Tên sản phẩm -->
            <TextView
                android:id="@+id/txt_ten_rau_muong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:fontFamily="serif"
                android:text="Rau muống"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Dòng chứa giá và nút thêm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- Giá sản phẩm -->
                <TextView
                    android:id="@+id/txt_gia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:fontFamily="serif"
                    android:text="10.000 VND"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <!-- Nút thêm vào giỏ hàng -->
                <Button
                    android:id="@+id/btn_add_shopping"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_gio_hang"
                    app:backgroundTint="@null"
                    tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>