<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Ảnh sản phẩm - ID CHUNG -->
            <ImageView
                android:id="@+id/img_product"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Ảnh sản phẩm"
                android:scaleType="centerCrop"
                android:src="@drawable/rau_muong" />

            <!-- Tên sản phẩm - ID CHUNG -->
            <TextView
                android:id="@+id/txt_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:fontFamily="serif"
                android:text="Rau muống"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Dòng chứa giá và nút thêm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Giá sản phẩm - ID CHUNG -->
                <TextView
                    android:id="@+id/txt_product_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="10.000 VND"
                    android:textSize="12sp" />

                <!-- Nhóm nút cộng trừ -->
                <LinearLayout
                    android:id="@+id/layout_add_remove"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_remove"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Giảm số lượng"
                        android:padding="5dp"
                        android:src="@drawable/ic_remove"
                        tools:ignore="TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/txt_so_luong_grid_cart"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_add"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Tăng số lượng"
                        android:padding="5dp"
                        android:src="@drawable/ic_add"
                        tools:ignore="HardcodedText,TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/btn_delete_product_cart"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="10dp"
                        android:background="#F0D8D8"
                        android:contentDescription="Xóa product"
                        android:elevation="2dp"
                        android:outlineSpotShadowColor="#80000000"
                        android:padding="5dp"
                        android:src="@drawable/icon_delete"
                        tools:ignore="HardcodedText,TouchTargetSizeCheck,UnusedAttribute" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>