<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    >

    <!-- Nội dung chính có thể cuộn -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/menu_admin"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="0dp">

            <!-- Dòng chào admin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_marginLeft="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Xin chào,"
                    android:textColor="@color/primary_dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_hello_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="serif"
                    android:hint="Admin"
                    android:textColor="@color/primary_green"
                    android:textColorHint="#78909C"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="serif"
                android:text="Quản lý sản phẩm và đơn hàng"
                android:textColor="#555555"
                android:textSize="14sp" />

            <!-- Thanh tìm kiếm -->
            <EditText
                android:id="@+id/search_bar_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/search_rounded"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:hint="Tìm kiếm sản phẩm..."
                android:importantForAutofill="no"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="#000000"
                android:textColorHint="#8D6E63"/>

            <!-- Tiêu đề danh sách sản phẩm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="9dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="serif"
                android:text="DANH SÁCH SẢN PHẨM"
                android:textColor="@color/primary_dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Nút thao tác nhanh -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_them_san_pham"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#4CAF50"
                    android:text="Thêm SP"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>

            <!-- Danh sách sản phẩm -->
            <GridView
                android:id="@+id/gv_ds_thuc_pham_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:horizontalSpacing="16dp"
                android:numColumns="2"
                android:padding="0dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="16dp"
                android:background="@color/background_light"
                tools:ignore="NestedScrolling" />
        </LinearLayout>
    </ScrollView>

    <!-- Menu admin cố định dưới -->
    <include
        android:id="@+id/menu_admin"
        layout="@layout/menu_admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/primary_green" />

</RelativeLayout>