<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:padding="5dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:background="@color/primary_green"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/txt_detail_don_hang"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:ignore="TextSizeCheck" />

        <!-- Card thông tin đơn hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/backgroung_thong_tin_chi_tiet_dat_hang"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txt_info_don_hang"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="12dp" />

            <!-- Danh sách sản phẩm từ giỏ hàng -->
            <TextView
                android:id="@+id/txt_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/info_khach_hang"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="serif"
                android:inputType="datetime"
                android:text="@string/txt_time"
                android:textColor="#666666"
                android:textSize="14sp"
                tools:ignore="TextViewEdits,TouchTargetSizeCheck" />

            <!-- Tổng tiền -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/txt_tong_thanh_toan"
                    android:fontFamily="serif"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/txt_tong_tien_thanh_toan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_0_VND"
                    android:fontFamily="serif"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E53935" />

            </LinearLayout>
        </LinearLayout>

        <!-- Card phương thức thanh toán -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/backgroung_thong_tin_chi_tiet_dat_hang"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/txt_pttt"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_cash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/txt_ttknh"
                    android:fontFamily="serif"
                    android:textSize="14sp"
                    android:checked="true" />

            </RadioGroup>
        </LinearLayout>

        <!-- Card thông tin giao hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/backgroung_thong_tin_chi_tiet_dat_hang"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thông tin giao hàng"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="12dp"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/edt_full_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Họ và tên"
                android:importantForAutofill="no"
                android:inputType="text"
                android:fontFamily="serif"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/edt_hcn_bo_tron"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/edt_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số điện thoại"
                android:fontFamily="serif"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/edt_hcn_bo_tron"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/edt_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Địa chỉ giao hàng"
                android:inputType="text"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/edt_hcn_bo_tron"
                tools:ignore="Autofill,HardcodedText" />


        </LinearLayout>

        <!-- Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="16dp"
            android:layout_gravity="bottom">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Hủy đơn"
                android:fontFamily="serif"
                android:textColor="#F2F1F1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/btn_hcn_bo_tron"
                app:backgroundTint="@null"
                android:layout_marginEnd="4dp"
                tools:ignore="ButtonStyle,HardcodedText" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/btn_dat_hang"
                android:fontFamily="serif"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/btn_hcn_bo_tron"
                app:backgroundTint="@null"
                android:layout_marginStart="4dp"
                tools:ignore="ButtonStyle" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>