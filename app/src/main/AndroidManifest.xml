<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppVegetables">

        <!-- Đặt login_register_activity làm màn hình khởi động -->
        <activity
            android:name=".login.login_register_activity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".login.login_forgot_pass"
            android:exported="true"/>
        <!--layout home-->
        <activity
            android:name=".home.Home"
            android:exported="true" />
        <activity
            android:name=".home.Product_info"
            android:exported="false" />


        <!--layout cart-->
        <activity android:name=".Cart.Cart_activity"
            android:exported="true"/>
        <activity android:name=".Order.Order_don_hang"
            android:exported="false"
            android:parentActivityName=".Cart.Cart_activity"/>


        <!--layout order-->
        <activity
            android:name=".Order.Order_Activity"
            android:exported="true" />
        <activity android:name=".Order.Order_don_dat"
            android:exported="true"/>


        <!--layout account-->
        <activity android:name=".account.Account"
            android:exported="true"/>
        <activity android:name=".account.account_thong_tin_ca_nhan"
            android:exported="true"/>
        <activity android:name=".account.account_doi_mat_khau"
            android:exported="true"/>
<!--admin-->
        <activity
            android:name=".home.Admin_activity"
            android:exported="false"
            android:screenOrientation="portrait" />



    </application>

</manifest>